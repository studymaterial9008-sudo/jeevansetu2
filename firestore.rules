rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /requests/{requestId} {
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.requesterId == request.auth.uid || resource.data.donorId == request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.requesterId == request.auth.uid || resource.data.donorId == request.auth.uid);
      allow delete: if signedIn() && resource.data.requesterId == request.auth.uid;
    }
  }
}
